# Local Chat Backend — Environment Variables

# HTTP Server
PORT=5000

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Ollama — Local AI runtime (must be started manually)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Google Gemini API Key (for Gemini 2.5 Flash cloud model)
# Get yours at: https://aistudio.google.com/app/apikey
# Leave empty to disable Gemini; only Ollama models will appear.
GEMINI_API_KEY=
